rules_version = '2';

// All writes go through callables (admin SDK); clients only read. Rules see the `role` claim
// only — permission strings are checked by the callables.
service cloud.firestore {
  match /databases/{database}/documents {
    function team() {
      return request.auth != null && request.auth.token.role in ['user', 'admin'];
    }

    match /user/{uid} {
      allow read: if team() || (request.auth != null && request.auth.uid == uid);
    }
    match /group/{id} {
      allow read: if team();
    }
    match /contact/{id} {
      allow read: if team();
      match /activity/{activityId} {
        allow read: if team();
      }
    }
    match /task/{id} {
      allow read: if team();
    }
    // Go-to-market strategies; edited through crm:strategy.*.
    match /strategy/{id} {
      allow read: if team();
    }
    // FLF facts and messaging (Knowledge); edited through core:knowledge.*. A restricted entry is
    // for admins only (the Knowledge page queries by audience for everyone else).
    match /knowledge/{id} {
      // `in` (not != restricted) so that a query without the audience filter is refused too.
      allow read: if request.auth != null && (request.auth.token.role == 'admin'
        || (team() && resource.data.audience in ['external', 'internal']));
    }
    // Meetings imported from the portal sheet's Events tab.
    match /event/{id} {
      allow read: if team();
    }
    match /automation/{id} {
      allow read: if team();
    }
    match /automationRun/{id} {
      allow read: if team();
    }
    // Settings only; secrets live in Secret Manager.
    match /connection/{id} {
      allow read: if team();
    }
    // FLF TV: videos, clips, transcripts and the two skills; written by tv.* actions and the Mac worker.
    match /tvVideo/{id} {
      allow read: if team();
    }
    match /tvClip/{id} {
      allow read: if team();
    }
    match /tvSkill/{id} {
      allow read: if team();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
